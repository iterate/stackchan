# Lowercase renders as small caps.
alias U+0061 U+0041
alias U+0062 U+0042
alias U+0063 U+0043
alias U+0064 U+0044
alias U+0065 U+0045
alias U+0066 U+0046
alias U+0067 U+0047
alias U+0068 U+0048
alias U+0069 U+0049
alias U+006A U+004A
alias U+006B U+004B
alias U+006C U+004C
alias U+006D U+004D
alias U+006E U+004E
alias U+006F U+004F
alias U+0070 U+0050
