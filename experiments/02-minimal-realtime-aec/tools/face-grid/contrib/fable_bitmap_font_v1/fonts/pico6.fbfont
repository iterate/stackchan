alias U+0073 U+0053
alias U+0074 U+0054
alias U+0075 U+0055
alias U+0076 U+0056
alias U+0077 U+0057
alias U+0078 U+0058
alias U+0079 U+0059
alias U+007A U+005A

# Common typographic input folds onto the ASCII art.
alias U+00E9 U+0045
alias U+2013 U+002D
alias U+2014 U+002D
alias U+2018 U+0027
alias U+2019 U+0027
alias U+201C U+0022
alias U+201D U+0022
