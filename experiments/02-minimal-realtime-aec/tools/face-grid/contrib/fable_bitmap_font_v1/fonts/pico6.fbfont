# pico6 — original micro pixel font for narrow panels (M5StickC/StickS3
# class). 5 px caps, mostly 3 px wide, 1 px descent row, 7 px line height.
# Lowercase input renders through uppercase aliases, the classic tiny-LCD
# trick, so transcripts stay legible at 1x on a 135 px wide screen.
# All pixels are original work authored for this project.

font pico6
line_height 7
ascent 5
descent 1
tracking 0
fallback U+FFFD

glyph U+0020   # space
adv 2
empty

glyph U+0021   # !
adv 2
bearing 0 5
rows
#
#
#
.
#
end

glyph U+0022   # "
adv 4
bearing 0 5
rows
#.#
#.#
end

glyph U+0027   # '
adv 2
bearing 0 5
rows
#
#
end

glyph U+0028   # (
adv 3
bearing 0 5
rows
.#
#.
#.
#.
.#
end

glyph U+0029   # )
adv 3
bearing 0 5
rows
#.
.#
.#
.#
#.
end

glyph U+002C   # ,
adv 2
bearing 0 1
rows
#
#
end

glyph U+002D   # -
adv 4
bearing 0 3
rows
###
end

glyph U+002E   # .
adv 2
bearing 0 1
rows
#
end

glyph U+002F   # /
adv 4
bearing 0 5
rows
..#
..#
.#.
#..
#..
end

