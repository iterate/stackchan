# Local secrets and machine-specific config (never commit)
**/.env
**/.env.*
**/local/
**/*.local.yaml
**/SC_SecConfig.yaml
!**/SC_SecConfig.yaml.example

# Upstream firmware checkouts / build trees (large; re-clone with scripts)
experiments/**/upstream/
experiments/**/worktree/

# PlatformIO / embedded build artifacts
**/.pio/
**/pio/
**/build/
**/managed_components/
**/sdkconfig
**/sdkconfig.old
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# OS / editor
.DS_Store
**/__pycache__/
**/*.pyc
**/node_modules/
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# Logs and dumps
*.log
*.bin
*.elf
*.map
